<Window x:Class="ShopDrawing.Plugin.UI.Manual.ManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hướng dẫn sử dụng ShopDrawing" Height="650" Width="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="#F5F6F8">
    <Window.Resources>
        <!-- Styles -->
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="BodyStyle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Border" x:Key="StepContainer">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="Ellipse" x:Key="StepNumberVariant">
            <Setter Property="Fill" Value="#E0EAFF" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="TextBlock" x:Key="StepNumberText">
            <Setter Property="Foreground" Value="#4338CA" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Margin="8" BorderThickness="0" Background="Transparent" SelectedIndex="0">
            <!-- Tab 1: Tender Phase -->
            <TabItem Header=" Luồng Công Việc Tender ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="4">
                        <!-- Intro text -->
                        <TextBlock Text="Cẩm nang bóc tách Tender" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,16">
                            Làm theo trình tự từng bước dưới đây để đạt được hiệu quả bóc tách khối lượng tốt nhất!
                        </TextBlock>

                        <!-- Step 1 -->
                        <Border Style="{StaticResource StepContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource StepNumberVariant}" />
                                    <TextBlock Text="1" Style="{StaticResource StepNumberText}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Khai báo Input Dự án" Style="{StaticResource HeaderStyle}" />
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        Thiết lập tên công trình, chủ đầu tư. Đây là bước bắt buộc để báo cáo hiển thị chuẩn thông tin.
                                    </TextBlock>
                                    <TextBlock Margin="0,8,0,0">
                                        <Hyperlink Click="OnRunCommand" CommandParameter="SD_INPUT ">
                                            <Run Text="👉 Mở bảng Input ngay" Foreground="#2563EB" FontWeight="Bold"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 2 -->
                        <Border Style="{StaticResource StepContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource StepNumberVariant}" />
                                    <TextBlock Text="2" Style="{StaticResource StepNumberText}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Tạo Spec Tường/Vách" Style="{StaticResource HeaderStyle}" />
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        Quy định biến vách, độ dày, khoảng ngàm và kích thước khổ tôn.
                                    </TextBlock>
                                    <TextBlock Margin="0,8,0,0">
                                        <Hyperlink Click="OnRunCommand" CommandParameter="SD_TAB ">
                                            <Run Text="👉 Mở Quản lý Spec" Foreground="#2563EB" FontWeight="Bold"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 3 -->
                        <Border Style="{StaticResource StepContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource StepNumberVariant}" />
                                    <TextBlock Text="3" Style="{StaticResource StepNumberText}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Quét khai báo Vách" Style="{StaticResource HeaderStyle}" />
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        Dùng chuột quét (Lệnh vẽ vách cơ bản hoặc gõ lệnh Pick vùng) để quét mảng vách vào hệ thống.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 4 -->
                        <Border Style="{StaticResource StepContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource StepNumberVariant}" />
                                    <TextBlock Text="4" Style="{StaticResource StepNumberText}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Khai báo Lỗ Cửa/Thông gió" Style="{StaticResource HeaderStyle}" />
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        Chọn các khu vực mở cửa sổ, cửa đi, ống gió... để phần mềm ghi nhận trừ hao hụt tôn.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 5 -->
                        <Border Style="{StaticResource StepContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource StepNumberVariant}" />
                                    <TextBlock Text="5" Style="{StaticResource StepNumberText}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Xuất BOM &amp; Vẽ CAD" Style="{StaticResource HeaderStyle}" />
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        Mở bảng Tender BOM, xem trước bản Preview dưới dạng CAD hoặc xuất chốt khối lượng chuẩn ra Excel.
                                    </TextBlock>
                                    <TextBlock Margin="0,8,0,0">
                                        <Hyperlink Click="OnRunCommand" CommandParameter="SD_TENDER_BOM ">
                                            <Run Text="👉 Mở bảng Khối lượng &amp; Xuất Excel" Foreground="#2563EB" FontWeight="Bold"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Tips & Tricks -->
            <TabItem Header=" Phím Tắt &amp; Mẹo Vặt ">
                <StackPanel Margin="16">
                    <TextBlock Text="Bí quyết thao tác nhanh:" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <TextBlock Style="{StaticResource HeaderStyle}" Text="• Không cần pick tuần tự" />
                    <TextBlock Style="{StaticResource BodyStyle}" Margin="12,0,0,16" Text="Quét vách xong, đổi Spec rồi quét vách khác thoải mái. Không cần phải làm từng cụm nhàm chán." />
                    
                    <TextBlock Style="{StaticResource HeaderStyle}" Text="• Hủy lệnh tức thì" />
                    <TextBlock Style="{StaticResource BodyStyle}" Margin="12,0,0,16" Text="Mọi thao tác lỡ tay quét sai đều có thể huỷ ngang bằng phím ESCAPE trên bàn phím." />

                    <TextBlock Style="{StaticResource HeaderStyle}" Text="• Làm chủ chuột giữa" />
                    <TextBlock Style="{StaticResource BodyStyle}" Margin="12,0,0,16" Text="Lăn chuột giữa để phóng to; Ấn và giữ chuột lăn để kéo di chuyển không gian dễ dàng." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
